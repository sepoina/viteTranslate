# output di "npm run dump" (test/exampleLangCompile.mjs): moduli di lingua compilati, tenuti
# lì come esempio da ispezionare. Si rigenerano a comando e seguono il playground, quindi
# versionarli vorrebbe dire un diff di file generati a ogni modifica delle traduzioni.
test/exampleCompiled/
/temp

# backup lasciati dal comando di sync accanto ai file di lingua
*.bak-corrupted-*
*.bak-erased-*
*.bak-migrated-*
