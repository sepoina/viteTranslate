# Everything a run regenerates. Kept in git: storyboard.md, storyboard.yaml, the .srt, credits.txt, poster.jpg.
.cache/
projects/*/capture/
projects/*/preview/
projects/*/audio/
projects/*/log/
projects/*/output/*.mp4
# The web video (output.web: mp4, webm, poster): the page that shows it keeps its own copy.
projects/*/output/*.web.*

# Background music: the tracks stay local (download them again from the links in credits.md).
commons/bkmusic/*
!commons/bkmusic/credits.md
