{
  "name": "vitetranslate-ide",
  "displayName": "viteTranslate",
  "description": "Your viteTranslate setup at a glance, in its own panel, and your marked strings highlighted as you type.",
  "version": "0.0.7",
  "preview": true,
  "publisher": "sepoina",
  "author": {
    "name": "Giancarlo Ghigi",
    "email": "giancarlo.ghigi@gmail.com"
  },
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sepoina/viteTranslate.git",
    "directory": "idePlugin"
  },
  "bugs": {
    "url": "https://github.com/sepoina/viteTranslate/issues"
  },
  "homepage": "https://github.com/sepoina/viteTranslate#readme",
  "keywords": [
    "vitetranslate",
    "vite",
    "i18n",
    "translation"
  ],
  "categories": [
    "Other"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "node scripts/code.mjs build",
    "package": "node scripts/code.mjs build package",
    "install:editor": "node scripts/code.mjs build devpack install",
    "dev": "node scripts/code.mjs build dev",
    "release": "node scripts/code.mjs check test build package upload",
    "tag": "node scripts/code.mjs tag"
  },
  "vsce": {
    "dependencies": false
  },
  "devDependencies": {
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/codicons": "^0.0.45",
    "rolldown": "^1.2.7"
  },
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode vite.config is not executed: only package.json is read."
    }
  },
  "contributes": {
    "configuration": {
      "title": "viteTranslate",
      "properties": {
        "vitetranslate.detailCommand": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "When **Sync** or an LLM action starts, its terminal shows the command you would type, like `npx vitetranslate --llm-translate`. Turn this on to also see how it is really launched: the project folder, the runtime, the runner and the CLI file."
        },
        "vitetranslate.highlightStyle": {
          "type": "string",
          "default": "framed-box",
          "enum": [
            "off",
            "framed-box",
            "badge",
            "dotted-escape",
            "escape-chip",
            "highlighter",
            "inlay-hint",
            "inset",
            "keyword-mark",
            "link",
            "neutral-italic",
            "outlined-chip",
            "pill",
            "placeholder",
            "quote",
            "selection-veil"
          ],
          "enumItemLabels": [
            "Off",
            "Framed box",
            "Badge",
            "Dotted escape",
            "Escape chip",
            "Highlighter",
            "Inlay hint",
            "Inset",
            "Keyword mark",
            "Link",
            "Neutral italic",
            "Outlined chip",
            "Pill",
            "Placeholder",
            "Quote",
            "Selection veil"
          ],
          "enumDescriptions": [
            "No highlighting",
            "Box and frame",
            "Filled label",
            "Fine underline",
            "Chip and ruler",
            "Marker effect",
            "Like inlay hints",
            "Inset backdrop",
            "Keyword accent",
            "Dotted link",
            "Italic only",
            "Chip with border",
            "Chip on content",
            "Snippet style",
            "Left accent bar",
            "Like selection"
          ],
          "markdownDescription": "How marked strings stand out in `.js`, `.jsx`, `.ts` and `.tsx` files: `_%_…_%_`, `<Translate>…</Translate>`, `` ts`…` ``. Colors come from your theme. To try them all live, run **viteTranslate: Choose highlight style…** from the Command Palette."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vitetranslate",
          "title": "viteTranslate",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "vitetranslate": [
        {
          "type": "webview",
          "id": "vitetranslate.selector",
          "name": "Selector",
          "when": "vitetranslate.ready && (!vitetranslate.optional || vitetranslate.libraryProblem && vitetranslate.manyProjects)"
        },
        {
          "id": "vitetranslate.results",
          "name": "Results",
          "when": "vitetranslate.ready && !vitetranslate.optional"
        },
        {
          "type": "webview",
          "id": "vitetranslate.optional",
          "name": "Loading",
          "when": "vitetranslate.optional || !vitetranslate.ready"
        },
        {
          "type": "webview",
          "id": "vitetranslate.project",
          "name": "Project",
          "when": "vitetranslate.ready && !vitetranslate.optional"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vitetranslate.results",
        "contents": "No Vite project in this workspace: no vite.config.* was found.\n[Refresh](command:vitetranslate.refresh)",
        "when": "!vitetranslate.hasProjects"
      },
      {
        "view": "vitetranslate.results",
        "contents": "Select a project in Selector to see what it marks for translation.",
        "when": "vitetranslate.hasProjects"
      }
    ],
    "taskDefinitions": [
      {
        "type": "vitetranslate",
        "required": [
          "command",
          "dir"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "What to run: sync"
          },
          "dir": {
            "type": "string",
            "description": "The project folder"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "vitetranslate.sync",
        "title": "Sync language files",
        "category": "viteTranslate",
        "icon": "$(sync)"
      },
      {
        "command": "vitetranslate.llm",
        "title": "LLM",
        "category": "viteTranslate",
        "icon": "$(sparkle)"
      },
      {
        "command": "vitetranslate.settings",
        "title": "Settings",
        "category": "viteTranslate",
        "icon": "$(settings-gear)"
      },
      {
        "command": "vitetranslate.closeOptional",
        "title": "Back",
        "category": "viteTranslate",
        "icon": "$(arrow-left)"
      },
      {
        "command": "vitetranslate.highlightStyle",
        "title": "Choose highlight style…",
        "category": "viteTranslate",
        "icon": "$(symbol-color)"
      },
      {
        "command": "vitetranslate.refresh",
        "title": "Refresh",
        "category": "viteTranslate",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vitetranslate.refresh",
          "when": "view == vitetranslate.results",
          "group": "navigation"
        },
        {
          "command": "vitetranslate.closeOptional",
          "when": "view == vitetranslate.optional && vitetranslate.ready && !vitetranslate.libraryProblem",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "vitetranslate.closeOptional",
          "when": "vitetranslate.optional && vitetranslate.ready && !vitetranslate.libraryProblem"
        }
      ]
    }
  }
}
