{
  "name": "vitetranslate-ide",
  "displayName": "viteTranslate",
  "description": "Your viteTranslate setup at a glance, in its own panel of the Activity Bar.",
  "version": "0.0.2",
  "preview": true,
  "publisher": "sepoina",
  "author": {
    "name": "Giancarlo Ghigi",
    "email": "giancarlo.ghigi@gmail.com"
  },
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sepoina/viteTranslate.git",
    "directory": "idePlugin"
  },
  "bugs": {
    "url": "https://github.com/sepoina/viteTranslate/issues"
  },
  "homepage": "https://github.com/sepoina/viteTranslate#readme",
  "keywords": [
    "vitetranslate",
    "vite",
    "i18n",
    "translation"
  ],
  "categories": [
    "Other"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode vite.config is not executed: only package.json is read."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vitetranslate",
          "title": "viteTranslate",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "vitetranslate": [
        {
          "id": "vitetranslate.project",
          "name": "Configs",
          "when": "!vitetranslate.singleProject"
        },
        {
          "id": "vitetranslate.marked",
          "name": "Marked"
        },
        {
          "id": "vitetranslate.details",
          "name": "Details"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vitetranslate.project",
        "contents": "No Vite project in this workspace: no vite.config.* was found.\n[Refresh](command:vitetranslate.refresh)"
      },
      {
        "view": "vitetranslate.marked",
        "contents": "No Vite project in this workspace: no vite.config.* was found.\n[Refresh](command:vitetranslate.refresh)",
        "when": "!vitetranslate.hasProjects"
      },
      {
        "view": "vitetranslate.marked",
        "contents": "Select a project in Configs to see what it marks for translation.",
        "when": "vitetranslate.hasProjects"
      },
      {
        "view": "vitetranslate.details",
        "contents": "No Vite project in this workspace: no vite.config.* was found.\n[Refresh](command:vitetranslate.refresh)",
        "when": "!vitetranslate.hasProjects"
      },
      {
        "view": "vitetranslate.details",
        "contents": "Select a project in Configs to see its setup.",
        "when": "vitetranslate.hasProjects"
      }
    ],
    "commands": [
      {
        "command": "vitetranslate.refresh",
        "title": "Refresh",
        "category": "viteTranslate",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vitetranslate.refresh",
          "when": "view == vitetranslate.project || view == vitetranslate.marked || view == vitetranslate.details",
          "group": "navigation"
        }
      ]
    }
  }
}
